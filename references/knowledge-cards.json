    {
      "id": "editing-reuse",
      "title": "可回修的镜头与资产",
      "keywords": [
        "回修",
        "复用",
        "多版本",
        "资产",
        "替换",
        "分镜",
        "workflow",
        "reuse",
        "revision"
      ],
      "inputs": [
        "稳定场景、句子、文字与素材ID",
        "实际改变的输入"
      ],
      "mechanism": "分离内容、风格、合成与生成资产；一个修改只让相关依赖失效，可保留无关镜头与已验证结果。",
      "compose": "图、表、拼贴共用同一内容登记；声音与镜头引用cue；有意变体不牵动原版本。",
      "alternative": "不要把批量模板当叙事；不为使用完整系统重写用户稿或重生成全部资产。",
